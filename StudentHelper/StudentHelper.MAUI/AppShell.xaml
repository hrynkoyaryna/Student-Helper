<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="StudentHelper.MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:StudentHelper.MAUI.Pages"
    xmlns:auth="clr-namespace:StudentHelper.MAUI.Pages.Authentication"
    xmlns:main="clr-namespace:StudentHelper.MAUI.Pages.Main"
    Title="StudentHelper"
    FlyoutBehavior="Disabled">

    <TabBar Route="auth">
        <ShellContent
            Title="Login"
            ContentTemplate="{DataTemplate auth:LoginPage}"
            Route="login"/>

        <ShellContent
            Title="Register"
            ContentTemplate="{DataTemplate auth:RegisterPage}"
            Route="register"/>

        <ShellContent
            Title="Forgot Password"
            ContentTemplate="{DataTemplate auth:ForgotPasswordPage}"
            Route="forgotpassword"/>
    </TabBar>

    <!-- ВИПРАВЛЕНО: Flyout для головного додатка (видно коли залогінені) -->
    <FlyoutItem Title="Main"
                Route="main"
                FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate main:MainPage}"
            Route="main"/>
    </FlyoutItem>

    <FlyoutItem Title="Study"
                Route="study"
                FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent
            Title="Notes"
            ContentTemplate="{DataTemplate main:NotesPage}"
            Route="notes"/>

        <ShellContent
            Title="Tasks"
            ContentTemplate="{DataTemplate main:TasksPage}"
            Route="tasks"/>

        <ShellContent
            Title="Exams"
            ContentTemplate="{DataTemplate main:ExamsPage}"
            Route="exams"/>
    </FlyoutItem>

    <FlyoutItem Title="Tools"
                Route="tools"
                FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent
            Title="Calendar"
            ContentTemplate="{DataTemplate main:CalendarPage}"
            Route="calendar"/>

        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate main:SettingsPage}"
            Route="settings"/>
    </FlyoutItem>

</Shell>