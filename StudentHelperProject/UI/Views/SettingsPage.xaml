<Page x:Class="StudentHelper.WPF.UI.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">

        <Grid>

                <!-- Заголовок -->
                <TextBlock Text="Налаштування"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,40,0,0"/>

                <!-- Центральна картка з пунктами меню -->
                <Border Width="280"
                        Background="#B8F1F1"
                        BorderBrush="Black"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <StackPanel Margin="24">

                                <Button Content="Профіль"
                                        Margin="0,0,0,8"
                                        Style="{StaticResource NavButton}"
                                        Click="Profile_Click"/>

                                <Button Content="Безпека (пароль)"
                                        Margin="0,0,0,8"
                                        Style="{StaticResource NavButton}"
                                        Click="Security_Click"/>

                                <Button Content="Про додаток"
                                        Margin="0,0,0,16"
                                        Style="{StaticResource NavButton}"
                                        Click="About_Click"/>

                                <Separator Margin="0,0,0,8"/>

                                <Button Content="Вийти з акаунту"
                                        Margin="0"
                                        Style="{StaticResource NavButton}"
                                        Click="Logout_Click"/>

                        </StackPanel>
                </Border>

        </Grid>
</Page>
