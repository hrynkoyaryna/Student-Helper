<Page x:Class="StudentHelper.WPF.UI.Views.CalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Month selector -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="MonthSelector"
                          Width="150" Height="32"
                          FontSize="14"
                          Margin="0,0,8,0"
                          SelectionChanged="MonthSelector_Changed">
                    <ComboBoxItem Content="Січень"/>
                    <ComboBoxItem Content="Лютий"/>
                    <ComboBoxItem Content="Березень"/>
                    <ComboBoxItem Content="Квітень"/>
                    <ComboBoxItem Content="Травень"/>
                    <ComboBoxItem Content="Червень"/>
                    <ComboBoxItem Content="Липень"/>
                    <ComboBoxItem Content="Серпень"/>
                    <ComboBoxItem Content="Вересень"/>
                    <ComboBoxItem Content="Жовтень"/>
                    <ComboBoxItem Content="Листопад"/>
                    <ComboBoxItem Content="Грудень"/>
                </ComboBox>

                <!-- Search box -->
                <Grid Width="220" Height="32">
                    <Border Background="White"
                            BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="6"/>
                    <Grid Margin="6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox"
                                 VerticalContentAlignment="Center"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"/>

                        <TextBlock Text="Пошук"
                                   Foreground="Gray"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <TextBlock Grid.Column="1" Text="🔍"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Row 1: Buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <Button x:Name="PrevButton"
                    Content="←"
                    Width="35" Height="30"
                    Margin="0,0,10,0"
                    Click="PrevButton_Click"/>

            <Button x:Name="TodayButton"
                    Content="Сьогодні"
                    Width="70" Height="30"
                    Margin="0,0,10,0"
                    Click="TodayButton_Click"/>

            <ToggleButton x:Name="DayButton"
                          Content="День"
                          Width="70" Height="30"
                          Margin="0,0,5,0"
                          Click="ViewModeButton_Click"/>

            <ToggleButton x:Name="WeekButton"
                          Content="Тиждень"
                          Width="80" Height="30"
                          Margin="0,0,5,0"
                          IsChecked="True"
                          Click="ViewModeButton_Click"/>

            <ToggleButton x:Name="MonthButton"
                          Content="Місяць"
                          Width="80" Height="30"
                          Margin="0,0,10,0"
                          Click="ViewModeButton_Click"/>

            <Button x:Name="NextButton"
                    Content="→"
                    Width="35" Height="30"
                    Click="NextButton_Click"/>
        </StackPanel>

        <!-- Row 2: Calendar -->
        <Border Grid.Row="2"
                BorderBrush="Black"
                BorderThickness="1">
            <Grid x:Name="CalendarGrid"
                  AllowDrop="True"/>
        </Border>

        <!-- Row 3: filters -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,10,0,0">
            <TextBlock Text="Фільтр:" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="PersonalFilterCheckBox" 
                      Content="Особисте" 
                      Margin="0,0,8,0"
                      Checked="FilterCheckBox_Changed"
                      Unchecked="FilterCheckBox_Changed"
                      IsChecked="True"/>
            <CheckBox x:Name="EducationalFilterCheckBox" 
                      Content="Навчальні"
                      Checked="FilterCheckBox_Changed"
                      Unchecked="FilterCheckBox_Changed"
                      IsChecked="True"/>
        </StackPanel>

        <!-- POPUP ДЕТАЛЕЙ ПОДІЇ -->
        <Popup x:Name="EventPopup"
               StaysOpen="False"
               Placement="MousePoint"
               AllowsTransparency="True">

            <Border Background="White"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    SnapsToDevicePixels="True">
                <StackPanel MinWidth="220">

                    <!-- Назва -->
                    <TextBlock x:Name="EventPopupTitleText"
                               FontWeight="Bold"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>

                    <!-- Дата і час -->
                    <TextBlock x:Name="EventPopupDateText"
                               FontSize="12"
                               Foreground="Gray"
                               Margin="0,0,0,6"/>

                    <!-- Локація -->
                    <TextBlock x:Name="EventPopupLocationText"
                               FontSize="12"
                               Margin="0,0,0,4"
                               TextWrapping="Wrap"/>

                    <!-- Опис -->
                    <TextBlock x:Name="EventPopupDescriptionText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Редагувати"
                                Margin="0,0,6,0"
                                Padding="8,2"
                                Click="EventPopup_Edit_Click"/>

                        <Button Content="Видалити"
                                Padding="8,2"
                                Background="#FFEB4B4B"
                                Foreground="White"
                                Click="EventPopup_Delete_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>

        </Popup>

    </Grid>
</Page>