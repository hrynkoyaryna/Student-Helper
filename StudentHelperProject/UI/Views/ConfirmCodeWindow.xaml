<Window x:Class="StudentHelper.WPF.UI.Views.ConfirmCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Підтвердження"
        Width="420" Height="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40">

            <!-- LOGO -->
            <Image Source="../Assets/logo.png"
                   Width="80" Height="80"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

            <TextBlock Text="Student Helper"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Введіть код підтвердження"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- INPUT -->
            <TextBox x:Name="CodeTextBox"
                     Height="40"
                     FontSize="18"
                     Padding="10"
                     Background="White"
                     BorderBrush="#444"
                     BorderThickness="1"
                     HorizontalAlignment="Center"
                     Width="200"
                     TextAlignment="Center"/>

            <!-- ERROR -->
            <TextBlock x:Name="ErrorText"
                       Text="*Невірний код. Спробуйте ще раз."
                       Foreground="Red"
                       FontSize="13"
                       Visibility="Collapsed"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"/>

            <!-- BUTTON -->
            <Button Content="Підтвердити"
                    Width="200"
                    Height="40"
                    Background="#B3ECFF"
                    Foreground="Black"
                    FontSize="16"
                    BorderBrush="#222"
                    BorderThickness="1"
                    Cursor="Hand"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Click="Confirm_Click"/>

        </StackPanel>
    </ScrollViewer>
</Window>
