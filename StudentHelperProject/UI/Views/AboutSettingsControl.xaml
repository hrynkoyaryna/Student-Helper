<UserControl x:Class="StudentHelper.WPF.UI.Views.AboutSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Border BorderBrush="Black"
            BorderThickness="1"
            Padding="20"
            Margin="20"
            Background="White">
        <StackPanel HorizontalAlignment="Center" Width="300">

            <TextBlock Text="Про додаток"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 0 0 20"
                       TextAlignment="Center"/>

            <TextBlock Text="Student Helper"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0 0 0 10"
                       TextAlignment="Center"/>

            <TextBlock Text="Версія: 1.0"
                       TextAlignment="Center"
                       Margin="0 0 0 5"/>

            <TextBlock Text="Додаток для планування пар, завдань, екзаменів та нотаток студентів."
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="10"/>
        </StackPanel>
    </Border>
</UserControl>
