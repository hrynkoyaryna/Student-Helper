<Window x:Class="StudentHelper.WPF.UI.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Student Helper – Вхід"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="420" Height="540"
        Background="White">

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40" VerticalAlignment="Center">

                <Image Source="../Assets/logo.png"
                       Width="80" Height="80"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

                <TextBlock Text="Student Helper"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="Black"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBox x:Name="EmailTextBox"
                         Margin="0,0,0,10"
                         Height="40"
                         FontSize="16"
                         Padding="10"
                         Background="White"
                         BorderBrush="#444"
                         BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="6"/>
                                            <ScrollViewer Margin="8,0" x:Name="PART_ContentHost"/>

                                            <TextBlock Text="E-mail"
                                                       Margin="14,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#999"
                                                       FontSize="16"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding Text.IsEmpty, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Grid Margin="0,0,0,5">
                    <PasswordBox x:Name="PasswordBox"
                                 Height="40"
                                 FontSize="16"
                                 Padding="10"
                                 Background="White"
                                 BorderBrush="#444"
                                 BorderThickness="1"
                                 Tag="Пароль"/>
                </Grid>

                <TextBlock x:Name="LoginErrorText"
                           Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="0,0,0,10"/>

                <Button x:Name="LoginButton"
                        Content="Увійти"
                        Height="40"
                        Background="#B3ECFF"
                        Foreground="Black"
                        FontSize="16"
                        BorderBrush="#222"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="LoginButton_Click"
                        Margin="0,5,0,10"/>

                <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0">
                <Hyperlink Click="ForgotPassword_Click" Foreground="#0057FF" TextDecorations="Underline">
                    Забули пароль?
                </Hyperlink>
                </TextBlock>

                <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0">
                <Hyperlink Click="GoToRegister_Click" Foreground="#0057FF" TextDecorations="Underline">
                    Ще не маєте акаунта? Зареєструватись
                </Hyperlink>
                </TextBlock>

            </StackPanel>
        </ScrollViewer>

        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
              d:Visibility="Visible">
            
            <Rectangle Fill="Black" Opacity="0.4"/>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="60" Height="60"
                             IsIndeterminate="True"
                             BorderThickness="4"
                             Foreground="#B3ECFF"/>
                
                <TextBlock Text="Вхід..." 
                           Foreground="White" 
                           FontWeight="Bold"
                           FontSize="18"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>