<Window x:Class="StudentHelper.WPF.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Helper"
        WindowStartupLocation="CenterScreen"
        Width="1200" Height="720"
        ResizeMode="CanMinimize"
        Background="White">

    <Window.Resources>
        <!-- Колір для активної кнопки -->
        <SolidColorBrush x:Key="ActiveNavButtonBackground" Color="#9ADDEA"/>
        <SolidColorBrush x:Key="ActiveNavButtonBorder" Color="DarkBlue"/>
        <SolidColorBrush x:Key="InactiveNavButtonBackground" Color="#B3F2FF"/>
        <SolidColorBrush x:Key="InactiveNavButtonBorder" Color="Black"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="#B3F2FF"
                BorderBrush="Black"
                BorderThickness="0,0,1,0">

            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="16,12,16,20">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="../Assets/logo.png" Width="40" Height="40" Margin="0,0,8,0"/>
                        <TextBlock Text="Student Helper"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Nav buttons -->
                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,0">
                    <Button x:Name="CalendarButton"
                            Click="CalendarButton_Click"
                            Margin="0,0,0,8"
                            Padding="10"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Background="{StaticResource ActiveNavButtonBackground}"
                            BorderBrush="{StaticResource ActiveNavButtonBorder}"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗓" Margin="0,0,8,0"/>
                            <TextBlock Text="Календар"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="TasksButton"
                            Click="TasksButton_Click"
                            Margin="0,0,0,8"
                            Padding="10"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Background="{StaticResource InactiveNavButtonBackground}"
                            BorderBrush="{StaticResource InactiveNavButtonBorder}"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✔" Margin="0,0,8,0"/>
                            <TextBlock Text="Завдання"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExamsButton"
                            Click="ExamsButton_Click"
                            Margin="0,0,0,8"
                            Padding="10"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Background="{StaticResource InactiveNavButtonBackground}"
                            BorderBrush="{StaticResource InactiveNavButtonBorder}"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎓" Margin="0,0,8,0"/>
                            <TextBlock Text="Екзамени"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NotesButton"
                            Click="NotesButton_Click"
                            Margin="0,0,0,8"
                            Padding="10"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Background="{StaticResource InactiveNavButtonBackground}"
                            BorderBrush="{StaticResource InactiveNavButtonBorder}"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📝" Margin="0,0,8,0"/>
                            <TextBlock Text="Нотатки"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SettingsButton"
                            Click="SettingsButton_Click"
                            Margin="0,0,0,8"
                            Padding="10"
                            FontSize="14"
                            HorizontalContentAlignment="Left"
                            Background="{StaticResource InactiveNavButtonBackground}"
                            BorderBrush="{StaticResource InactiveNavButtonBorder}"
                            Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Margin="0,0,8,0"/>
                            <TextBlock Text="Налаштування"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Grid Grid.Row="0" Background="White" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Add Event -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Button x:Name="AddEventTopButton"
                            Content="Додати подію"
                            Padding="16,6"
                            Margin="0,0,8,0"
                            Background="#B3F2FF"
                            BorderBrush="Black"
                            Click="AddEventTopButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#9FE0E0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Right: Settings + Profile -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <Button Content="⚙"
                            Width="32" Height="32"
                            Background="White"
                            BorderBrush="Black"
                            Click="SettingsButton_Click"
                            Style="{StaticResource ActionButton}"/>

                    <TextBlock x:Name="UserNameText"
                               Text="Імʼя Прізвище"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>

            <!-- CONTENT FRAME -->
            <Frame x:Name="MainFrame"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   JournalOwnership="OwnsJournal"/>
        </Grid>
    </Grid>
</Window>