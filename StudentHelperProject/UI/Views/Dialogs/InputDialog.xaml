<Window x:Class="StudentHelper.WPF.UI.Views.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новий предмет"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="400" Height="200"
        Background="White">

    <Border Padding="20" Background="White" BorderBrush="Black" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="MessageText" 
                       FontSize="16" 
                       Margin="0,0,0,15"
                       TextWrapping="Wrap"/>

            <TextBox x:Name="InputBox"
                     Height="36"
                     FontSize="16"
                     Padding="10"
                     BorderBrush="Black"
                     BorderThickness="1"
                     Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Скасувати"
                        Width="90" Height="32"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>

                <Button Content="Зберегти"
                        Width="90" Height="32"
                        Background="#B3F2FF"
                        BorderBrush="Black"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>