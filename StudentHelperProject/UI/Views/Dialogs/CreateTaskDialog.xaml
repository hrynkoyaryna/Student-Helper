<Window x:Class="StudentHelper.WPF.UI.Views.Dialogs.CreateTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Нове завдання"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Background="White"
        MinWidth="400">

    <Border Padding="20" Background="White" BorderBrush="Black" BorderThickness="1">
        <StackPanel Width="360">
            <!-- Анімація появи всього діалогу -->
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.3"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>

            <!-- Заголовок -->
            <TextBlock Text="Створення завдання"
                       Style="{StaticResource H2}"
                       Margin="0,0,0,15">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="TitleTransform" Y="-10"/>
                </TextBlock.RenderTransform>
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TitleTransform"
                                               Storyboard.TargetProperty="Y"
                                               From="-10" To="0" Duration="0:0:0.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>

            <!-- Назва -->
            <TextBlock Text="Назва*" Style="{StaticResource H3}" Margin="0,0,0,4"/>
            <TextBox x:Name="TitleBox"
                     Style="{StaticResource StandardTextBox}">
                <TextBox.Triggers>
                    <EventTrigger RoutedEvent="GotFocus">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                              To="#007ACC" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="LostFocus">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                              To="Black" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBox.Triggers>
            </TextBox>

            <!-- Опис -->
            <TextBlock Text="Опис" Style="{StaticResource H3}" Margin="0,0,0,4"/>
            <TextBox x:Name="DescriptionBox"
                     Height="70"
                     FontSize="14"
                     Padding="10"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     BorderBrush="Black"
                     BorderThickness="1"
                     Margin="0,0,0,10">
                <TextBox.Triggers>
                    <EventTrigger RoutedEvent="GotFocus">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                              To="#007ACC" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="LostFocus">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                              To="Black" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBox.Triggers>
            </TextBox>

            <!-- Категорія -->
            <TextBlock Text="Категорія*" Style="{StaticResource H3}" Margin="0,0,0,4"/>
            <ComboBox x:Name="CategoryBox" 
                      Style="{StaticResource StandardComboBox}">
                <ComboBoxItem Content="Особисте"/>
                <ComboBoxItem Content="Навчання" IsSelected="True"/>
            </ComboBox>

            <!-- Предмет - показується тільки для навчання -->
            <TextBlock x:Name="SubjectLabel"
                       Text="Предмет (для навчання)*" 
                       Style="{StaticResource H3}" 
                       Margin="0,0,0,4"/>
            <TextBox x:Name="SubjectBox"
                     Style="{StaticResource StandardTextBox}">
                <TextBox.Triggers>
                    <EventTrigger RoutedEvent="GotFocus">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                              To="#007ACC" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="LostFocus">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                              To="Black" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBox.Triggers>
            </TextBox>

            <!-- Дата -->
            <TextBlock Text="Дата виконання*" Style="{StaticResource H3}" Margin="0,0,0,4"/>
            <DatePicker x:Name="DatePicker"
                        Style="{StaticResource StandardDatePicker}"
                        SelectedDate="{x:Static sys:DateTime.Today}"/>

            <!-- Час -->
            <TextBlock Text="Час*" Style="{StaticResource H3}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <ComboBox x:Name="HourBox" 
                          Width="80" Height="36"
                          FontSize="14"
                          BorderBrush="Black" 
                          BorderThickness="1"
                          SelectedIndex="8">
                    <ComboBoxItem Content="08"/>
                    <ComboBoxItem Content="09"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="11"/>
                    <ComboBoxItem Content="12"/>
                    <ComboBoxItem Content="13"/>
                    <ComboBoxItem Content="14"/>
                    <ComboBoxItem Content="15"/>
                    <ComboBoxItem Content="16"/>
                    <ComboBoxItem Content="17"/>
                    <ComboBoxItem Content="18"/>
                    <ComboBoxItem Content="19"/>
                    <ComboBoxItem Content="20"/>
                </ComboBox>

                <TextBlock Text=":" VerticalAlignment="Center" Margin="8,0,8,0" FontSize="14"/>

                <ComboBox x:Name="MinuteBox"
                          Width="80" Height="36"
                          FontSize="14"
                          BorderBrush="Black"
                          BorderThickness="1"
                          SelectedIndex="0">
                    <ComboBoxItem Content="00"/>
                    <ComboBoxItem Content="15"/>
                    <ComboBoxItem Content="30"/>
                    <ComboBoxItem Content="45"/>
                </ComboBox>
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Скасувати"
                        Width="90" Height="32"
                        Margin="0,0,10,0"
                        Click="Cancel_Click">
                    <Button.RenderTransform>
                        <ScaleTransform/>
                    </Button.RenderTransform>
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                     To="1.05" Duration="0:0:0.1"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                     To="1.05" Duration="0:0:0.1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                     To="1" Duration="0:0:0.1"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                     To="1" Duration="0:0:0.1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>
                <Button Content="Створити"
                        Width="90" Height="32"
                        Background="#B3F2FF"
                        BorderBrush="Black"
                        Click="Create_Click">
                    <Button.RenderTransform>
                        <ScaleTransform/>
                    </Button.RenderTransform>
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                     To="1.05" Duration="0:0:0.1"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                     To="1.05" Duration="0:0:0.1"/>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                  To="#9FE0E0" Duration="0:0:0.1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                     To="1" Duration="0:0:0.1"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                     To="1" Duration="0:0:0.1"/>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                  To="#B3F2FF" Duration="0:0:0.1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>