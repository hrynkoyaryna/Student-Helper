<Window x:Class="StudentHelper.WPF.UI.Views.Dialogs.CreateEventDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Нова подія"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Background="White"
        Height="600" Width="450">

    <Border Padding="20" Background="White" BorderBrush="Black" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Width="400">

                <!-- Заголовок + кнопка -->
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="Нова подія"
                               FontSize="20"
                               FontWeight="Bold"
                               DockPanel.Dock="Left"/>
                    <Button Content="Зберегти"
                            Width="100"
                            Height="32"
                            Background="#B3ECFF"
                            BorderBrush="Black"
                            BorderThickness="1"
                            HorizontalAlignment="Right"
                            Click="SaveButton_Click"/>
                </DockPanel>

                <!-- Назва -->
                <TextBlock Text="Назва події*" FontWeight="Bold" Margin="0,4,0,4"/>
                <TextBox x:Name="TitleBox"
                         Height="36"
                         Margin="0,0,0,10"
                         FontSize="16"
                         Padding="10"
                         BorderBrush="Black"
                         BorderThickness="1"/>

                <!-- Місце -->
                <TextBlock Text="Місце" FontWeight="Bold" Margin="0,4,0,4"/>
                <TextBox x:Name="LocationBox"
                         Height="36"
                         Margin="0,0,0,10"
                         FontSize="16"
                         Padding="10"
                         BorderBrush="Black"
                         BorderThickness="1"
                         Tag="Додайте місце"/>

                <!-- Дата -->
                <TextBlock Text="Дата*" FontWeight="Bold" Margin="0,4,0,4"/>
                <DatePicker x:Name="DatePicker"
                            SelectedDate="{x:Static sys:DateTime.Today}"
                            BorderBrush="Black"
                            BorderThickness="1"
                            Margin="0,0,0,10"
                            Height="30"/>

                <!-- Час початку -->
                <TextBlock Text="Час початку*" FontWeight="Bold" Margin="0,4,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ComboBox x:Name="StartHourBox"
                              Width="80"
                              Height="30"
                              BorderBrush="Black" 
                              BorderThickness="1"
                              SelectedIndex="8">
                        <ComboBoxItem Content="08"/>
                        <ComboBoxItem Content="09"/>
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="11"/>
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="13"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="15"/>
                        <ComboBoxItem Content="16"/>
                        <ComboBoxItem Content="17"/>
                        <ComboBoxItem Content="18"/>
                        <ComboBoxItem Content="19"/>
                        <ComboBoxItem Content="20"/>
                    </ComboBox>

                    <TextBlock Text=":" VerticalAlignment="Center" Margin="8,0,8,0" FontSize="14"/>

                    <ComboBox x:Name="StartMinuteBox"
                              Width="80"
                              Height="30"
                              BorderBrush="Black"
                              BorderThickness="1"
                              SelectedIndex="0">
                        <ComboBoxItem Content="00"/>
                        <ComboBoxItem Content="15"/>
                        <ComboBoxItem Content="30"/>
                        <ComboBoxItem Content="45"/>
                    </ComboBox>
                </StackPanel>

                <!-- Час закінчення -->
                <TextBlock Text="Час закінчення*" FontWeight="Bold" Margin="0,4,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <ComboBox x:Name="EndHourBox"
                              Width="80"
                              Height="30"
                              BorderBrush="Black" 
                              BorderThickness="1"
                              SelectedIndex="9">
                        <ComboBoxItem Content="08"/>
                        <ComboBoxItem Content="09"/>
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="11"/>
                        <ComboBoxItem Content="12"/>
                        <ComboBoxItem Content="13"/>
                        <ComboBoxItem Content="14"/>
                        <ComboBoxItem Content="15"/>
                        <ComboBoxItem Content="16"/>
                        <ComboBoxItem Content="17"/>
                        <ComboBoxItem Content="18"/>
                        <ComboBoxItem Content="19"/>
                        <ComboBoxItem Content="20"/>
                    </ComboBox>

                    <TextBlock Text=":" VerticalAlignment="Center" Margin="8,0,8,0" FontSize="14"/>

                    <ComboBox x:Name="EndMinuteBox"
                              Width="80"
                              Height="30"
                              BorderBrush="Black"
                              BorderThickness="1"
                              SelectedIndex="0">
                        <ComboBoxItem Content="00"/>
                        <ComboBoxItem Content="15"/>
                        <ComboBoxItem Content="30"/>
                        <ComboBoxItem Content="45"/>
                    </ComboBox>
                </StackPanel>

                <!-- Тип події -->
                <TextBlock Text="Тип події*" FontWeight="Bold" Margin="0,4,0,4"/>
                <ComboBox x:Name="TypeBox"
                          Height="30"
                          BorderBrush="Black"
                          BorderThickness="1"
                          Margin="0,0,0,10"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Навчальна"/>
                    <ComboBoxItem Content="Особиста"/>
                </ComboBox>

                <!-- Колір події -->
                <TextBlock Text="Колір події" FontWeight="Bold" Margin="0,4,0,4"/>
                <ComboBox x:Name="ColorBox" 
                          Height="30"
                          Margin="0,0,0,10"
                          SelectedIndex="0">
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="LightBlue" Margin="0,0,8,0"/>
                            <TextBlock Text="Синій" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="LightGreen" Margin="0,0,8,0"/>
                            <TextBlock Text="Зелений" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="LightPink" Margin="0,0,8,0"/>
                            <TextBlock Text="Рожевий" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="LightYellow" Margin="0,0,8,0"/>
                            <TextBlock Text="Жовтий" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="LightCoral" Margin="0,0,8,0"/>
                            <TextBlock Text="Кораловий" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

                <!-- Повторюваність -->
                <TextBlock Text="Повторюваність" FontWeight="Bold" Margin="0,4,0,4"/>
                <ComboBox x:Name="RecurrenceBox"
                          Height="30"
                          Margin="0,0,0,10"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Ніколи"/>
                    <ComboBoxItem Content="Щоденно"/>
                    <ComboBoxItem Content="Щотижня"/>
                    <ComboBoxItem Content="Щомісяця"/>
                </ComboBox>

                <!-- Опис -->
                <TextBlock Text="Опис" FontWeight="Bold" Margin="0,4,0,4"/>
                <TextBox x:Name="DescriptionBox"
                         Height="100"
                         Padding="10"
                         FontSize="14"
                         TextWrapping="Wrap"
                         BorderBrush="Black"
                         BorderThickness="1"
                         AcceptsReturn="True"
                         Tag="Додайте опис"/>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>