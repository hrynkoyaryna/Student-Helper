<Window x:Class="StudentHelper.WPF.UI.Views.Dialogs.CreateExamDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Новий екзамен"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="620" Height="450"
        Background="White">

    <Border BorderBrush="Black" BorderThickness="1" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- MAIN FIELDS -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Назва -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Назва*" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TitleBox"
                             Height="36"
                             FontSize="16"
                             Padding="10"
                             BorderBrush="Black"
                             BorderThickness="1"
                             Margin="0,0,0,12"/>
                </StackPanel>

                <!-- Опис -->
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="Опис" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox x:Name="DescriptionBox"
                             Height="36"
                             FontSize="16"
                             Padding="10"
                             BorderBrush="Black"
                             BorderThickness="1"
                             Margin="0,0,0,12"/>
                </StackPanel>

                <!-- Предмет -->
                <StackPanel Grid.Column="0" Margin="0,80,12,0">
                    <TextBlock Text="Предмет*" FontWeight="Bold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="SubjectBox"
                                  Height="36"
                                  Width="180"
                                  FontSize="14"
                                  BorderBrush="Black"
                                  BorderThickness="1"
                                  Margin="0,0,8,12"/>

                        <Button Content="+"
                                Width="34"
                                Height="34"
                                Background="#B3F2FF"
                                BorderBrush="Black"
                                Click="AddSubject_Click"
                                ToolTip="Додати новий предмет"/>
                    </StackPanel>
                </StackPanel>

                <!-- Тип -->
                <StackPanel Grid.Column="1" Margin="12,80,0,0">
                    <TextBlock Text="Тип*" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="TypeBox"
                              Height="36"
                              FontSize="14"
                              BorderBrush="Black"
                              BorderThickness="1"
                              Margin="0,0,0,12">
                        <ComboBoxItem Content="Залік"/>
                        <ComboBoxItem Content="Іспит" IsSelected="True"/>
                        <ComboBoxItem Content="Модуль"/>
                    </ComboBox>
                </StackPanel>

                <!-- Дата -->
                <StackPanel Grid.Column="0" Margin="0,160,12,0">
                    <TextBlock Text="Дата*" FontWeight="Bold" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DatePicker"
                                Height="36"
                                FontSize="14"
                                BorderBrush="Black"
                                BorderThickness="1"
                                SelectedDate="{x:Static sys:DateTime.Today}"
                                Margin="0,0,0,12"/>
                </StackPanel>

                <!-- Час -->
                <StackPanel Grid.Column="1" Margin="12,160,0,0">
                    <TextBlock Text="Час*" FontWeight="Bold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ComboBox x:Name="HourBox" 
                                  Width="80" Height="36"
                                  FontSize="14"
                                  BorderBrush="Black" 
                                  BorderThickness="1"
                                  SelectedIndex="2">
                            <ComboBoxItem Content="08"/>
                            <ComboBoxItem Content="09"/>
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="11"/>
                            <ComboBoxItem Content="12"/>
                            <ComboBoxItem Content="13"/>
                            <ComboBoxItem Content="14"/>
                            <ComboBoxItem Content="15"/>
                            <ComboBoxItem Content="16"/>
                            <ComboBoxItem Content="17"/>
                            <ComboBoxItem Content="18"/>
                            <ComboBoxItem Content="19"/>
                            <ComboBoxItem Content="20"/>
                        </ComboBox>

                        <TextBlock Text=":" VerticalAlignment="Center" Margin="8,0,8,0" FontSize="14"/>

                        <ComboBox x:Name="MinuteBox"
                                  Width="80" Height="36"
                                  FontSize="14"
                                  BorderBrush="Black"
                                  BorderThickness="1"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="00"/>
                            <ComboBoxItem Content="15"/>
                            <ComboBoxItem Content="30"/>
                            <ComboBoxItem Content="45"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- BUTTONS -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Зберегти"
                        Width="110" Height="32"
                        Background="#B3F2FF"
                        BorderBrush="Black"
                        Margin="0,0,10,0"
                        Click="Save_Click"/>
                <Button Content="Скасувати"
                        Width="110" Height="32"
                        BorderBrush="Black"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>