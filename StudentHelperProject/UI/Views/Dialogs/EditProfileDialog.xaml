<Window x:Class="StudentHelper.WPF.UI.Views.Dialogs.EditProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редагувати профіль"
        Height="260"
        Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        Icon="{x:Null}">

    <Border Background="White"
            Padding="20"
            BorderBrush="Black"
            BorderThickness="1">

        <StackPanel>

            <TextBlock Text="Редагувати профіль"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Ім'я *"
                    Margin="0,0,0,4"/>
            <TextBox x:Name="FirstNameBox"
                     Height="28"
                     Margin="0,0,0,12"
                     Padding="8"/>

            <TextBlock Text="Прізвище *"
                    Margin="0,0,0,4"/>
            <TextBox x:Name="LastNameBox"
                     Height="28"
                     Margin="0,0,0,16"
                     Padding="8"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Скасувати"
                        Width="90"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"
                        Background="LightGray"
                        BorderBrush="#222"
                        FontSize="13"/>

                <Button Content="Зберегти"
                        Width="90"
                        Style="{StaticResource DialogButton}"
                        Click="Save_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
