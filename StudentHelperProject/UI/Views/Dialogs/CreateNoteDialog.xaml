<Window x:Class="StudentHelper.WPF.UI.Views.Dialogs.CreateNoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Нотатка"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="540" Height="460"
        Background="White">

    <Border BorderBrush="Black" BorderThickness="1" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ЗАГОЛОВОК -->
            <TextBlock x:Name="DialogTitle"
                       Text="Нова нотатка"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <!-- ОСНОВНІ ПОЛЯ -->
            <StackPanel Grid.Row="1">
                <!-- Назва -->
                <TextBlock Text="Назва*" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="TitleBox"
                         Height="36"
                         FontSize="16"
                         Padding="10"
                         BorderBrush="Black"
                         BorderThickness="1"
                         Margin="0,0,0,15"/>

                <!-- Текст нотатки -->
                <TextBlock Text="Текст нотатки" FontWeight="Bold" Margin="0,0,0,4"/>
                <Border BorderBrush="Black" BorderThickness="1" CornerRadius="2">
                    <ScrollViewer Height="200" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="ContentBox"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Padding="10"
                                 FontSize="14"/>
                    </ScrollViewer>
                </Border>

                <!-- Закріпити -->
                <CheckBox x:Name="PinCheckbox"
                          Content="📌 Закріпити нотатку"
                          FontSize="14"
                          Margin="0,15,0,0"/>
            </StackPanel>

            <!-- КНОПКИ -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="Скасувати"
                        Width="110"
                        Height="34"
                        BorderBrush="Black"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button Content="Зберегти"
                        Width="110"
                        Height="34"
                        Background="#B3F2FF"
                        BorderBrush="Black"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>