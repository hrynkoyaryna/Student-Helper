<Window x:Class="StudentHelper.WPF.UI.Views.Dialogs.EditExamDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редагування іспиту"
        Width="480"
        Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <TextBlock Text="Редагування іспиту"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- Title -->
            <TextBlock Text="Назва іспиту *"
                    FontWeight="SemiBold"
                    Margin="0,0,0,5"/>
            <TextBox x:Name="TitleBox"
                     Height="35"
                     FontSize="14"
                     Padding="8"
                     BorderBrush="#444"
                     Margin="0,0,0,12"/>

            <!-- Subject -->
            <TextBlock Text="Предмет *"
                    FontWeight="SemiBold"
                    Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,12">
                <ComboBox x:Name="SubjectBox"
                          Height="35"
                          Width="370"
                          FontSize="14"
                          Padding="8"/>
                <Button Content="+"
                        Width="35"
                        Height="35"
                        Margin="8,0,0,0"
                        Background="#B3F2FF"
                        BorderBrush="#444"
                        Click="AddSubject_Click"/>
            </StackPanel>

            <!-- Date -->
            <TextBlock Text="Дата іспиту *"
                    FontWeight="SemiBold"
                    Margin="0,0,0,5"/>
            <DatePicker x:Name="DatePicker"
                        Height="35"
                        FontSize="14"
                        Margin="0,0,0,12"/>

            <!-- Time -->
            <TextBlock Text="Час іспиту *"
                    FontWeight="SemiBold"
                    Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,12">
                <ComboBox x:Name="HourBox"
                        Width="80"
                        Height="35"
                        FontSize="14">
                    <ComboBoxItem Content="08"/>
                    <ComboBoxItem Content="09"/>
                    <ComboBoxItem Content="10"
                            IsSelected="True"/>
                    <ComboBoxItem Content="11"/>
                    <ComboBoxItem Content="12"/>
                    <ComboBoxItem Content="13"/>
                    <ComboBoxItem Content="14"/>
                    <ComboBoxItem Content="15"/>
                    <ComboBoxItem Content="16"/>
                    <ComboBoxItem Content="17"/>
                    <ComboBoxItem Content="18"/>
                </ComboBox>
                <TextBlock Text=":"
                        VerticalAlignment="Center"
                        Margin="8,0,8,0"
                        FontSize="18"/>
                <ComboBox x:Name="MinuteBox"
                        Width="80"
                        Height="35"
                        FontSize="14">
                    <ComboBoxItem Content="00"
                            IsSelected="True"/>
                    <ComboBoxItem Content="15"/>
                    <ComboBoxItem Content="30"/>
                    <ComboBoxItem Content="45"/>
                </ComboBox>
            </StackPanel>

            <!-- Description -->
            <TextBlock Text="Опис іспиту"
                    FontWeight="SemiBold"
                    Margin="0,0,0,5"/>
            <TextBox x:Name="DescriptionBox"
                     Height="80"
                     FontSize="14"
                     Padding="8"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     BorderBrush="#444"
                     Margin="0,0,0,20"/>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Зберегти"
                        Grid.Column="0"
                        Height="40"
                        Margin="0,0,8,0"
                        Background="#B3ECFF"
                        BorderBrush="#222"
                        FontSize="15"
                        Click="Save_Click"/>

                <Button Content="Скасувати"
                        Grid.Column="1"
                        Height="40"
                        Margin="8,0,0,0"
                        Background="LightGray"
                        BorderBrush="#222"
                        FontSize="15"
                        Click="Cancel_Click"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
