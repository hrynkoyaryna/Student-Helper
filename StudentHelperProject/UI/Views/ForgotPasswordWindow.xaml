<Window x:Class="StudentHelper.WPF.UI.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Відновлення пароля"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="420" Height="420"
        Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40" VerticalAlignment="Center">

            <!-- LOGO -->
            <Image Source="../Assets/logo.png"
                   Width="80" Height="80"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

            <!-- TITLE -->
            <TextBlock Text="Student Helper"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

            <!-- PAGE SUBTITLE -->
            <TextBlock Text="Відновлення паролю"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- EMAIL TEXTBOX -->
            <TextBox x:Name="EmailTextBox"
                     Margin="0,0,0,5"
                     Height="40"
                     FontSize="16"
                     Padding="10"
                     Background="White"
                     BorderBrush="#444"
                     BorderThickness="1">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid>
                                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"/>
                                        <ScrollViewer Margin="8,0" x:Name="PART_ContentHost"/>

                                        <!-- Placeholder -->
                                        <TextBlock Text="E-mail"
                                                   Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#999"
                                                   IsHitTestVisible="False"
                                                   FontSize="16"
                                                   Visibility="{Binding Text.IsEmpty,
                                                               RelativeSource={RelativeSource TemplatedParent},
                                                               Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- ERROR -->
            <TextBlock x:Name="ErrorText"
                       Text="*Введіть коректну адресу електронної пошти."
                       Foreground="Red"
                       FontSize="13"
                       Margin="0,5,0,10"
                       Visibility="Collapsed"/>

            <!-- BUTTON -->
            <Button x:Name="SendButton"
                    Content="Відновити пароль"
                    Height="40"
                    Background="#B3ECFF"
                    Foreground="Black"
                    FontSize="16"
                    BorderBrush="#222"
                    BorderThickness="1"
                    Cursor="Hand"
                    Margin="0,10,0,10"
                    Click="SendButton_Click"/>

        </StackPanel>
    </ScrollViewer>
</Window>
