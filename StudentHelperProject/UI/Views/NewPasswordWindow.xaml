<Window x:Class="StudentHelper.WPF.UI.Views.NewPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новий пароль"
        Width="420"
        Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40">

            <!-- LOGO -->
            <Image Source="../Assets/logo.png"
                   Width="80"
                    Height="80"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

            <TextBlock Text="Створіть новий пароль"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Пароль має містити мінімум 8 символів"
                       Foreground="#666"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- CURRENT PASSWORD -->
            <TextBlock x:Name="CurrentPasswordLabel"
                       Text="Поточний пароль"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <PasswordBox x:Name="CurrentPasswordBox"
                         Height="40"
                         FontSize="16"
                         Padding="10"
                         Background="White"
                         BorderBrush="#444"
                         BorderThickness="1"
                         Margin="0,0,0,15"/>

            <!-- NEW PASSWORD -->
            <TextBlock Text="Новий пароль"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <PasswordBox x:Name="NewPasswordBox"
                         Height="40"
                         FontSize="16"
                         Padding="10"
                         Background="White"
                         BorderBrush="#444"
                         BorderThickness="1"
                         Margin="0,0,0,15"/>

            <!-- CONFIRM PASSWORD -->
            <TextBlock Text="Підтвердіть новий пароль"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <PasswordBox x:Name="ConfirmPasswordBox"
                         Height="40"
                         FontSize="16"
                         Padding="10"
                         Background="White"
                         BorderBrush="#444"
                         BorderThickness="1"
                         Margin="0,0,0,5"/>

            <!-- ERROR -->
            <TextBlock x:Name="ErrorText"
                       Text="*Паролі не співпадають або надто короткі."
                       Foreground="Red"
                       FontSize="13"
                       Visibility="Collapsed"
                       Margin="0,8,0,10"/>

            <!-- BUTTON -->
            <Button x:Name="SubmitButton"
                    Content="Готово"
                    Height="40"
                    Background="#B3ECFF"
                    Foreground="Black"
                    FontSize="16"
                    BorderBrush="#222"
                    BorderThickness="1"
                    Cursor="Hand"
                    Margin="0,15,0,0"
                    Click="Submit_Click"/>

        </StackPanel>
    </ScrollViewer>
</Window>
